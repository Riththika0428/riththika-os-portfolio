# Added in Phase 17 (Authentication)
JWT_SECRET=
JWT_EXPIRES_IN=7d

ADMIN_AUTH_SECRET=

# Copy this file to `.env` and fill in the values. NEVER commit the real .env file.

PORT=5000

# The website that is allowed to call this API (and to send the login cookie).
# Local: http://localhost:3000   Production: your deployed site, e.g. https://your-site.vercel.app
CLIENT_URL=http://localhost:3000

# MongoDB Atlas connection string. Leave blank here; paste the real one only in .env
MONGODB_URI=

# Secret used to sign admin login tokens. Must be 32+ random characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_AUTH_SECRET=

# Only needed once, for `npm run create-admin`. Password must be 12+ characters.
# Delete these two lines from .env after the admin has been created.
SEED_ADMIN_EMAIL= riththikabaskaran0428@gmail.com
SEED_ADMIN_PASSWORD=Reena2808
